# Copy this file to .env.local and fill in your values
# This file should NOT be committed to git

# Optional: Email service for contact form
# Option A — Resend (recommended, free tier available)
RESEND_API_KEY=

# Option B — EmailJS (client-side, no backend needed)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Option C — Formspree (simplest, just update the form action URL)
# No env vars needed — just replace the form action URL in ContactSection.tsx

# Site URL (used for OG tags)
NEXT_PUBLIC_SITE_URL=https://yourname.dev
